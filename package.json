{
  "name": "fatefi",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @fatefi/api dev",
    "dev:web": "pnpm --filter @fatefi/web dev",
    "dev": "pnpm dev:api & pnpm dev:web",
    "moltbook": "pnpm --filter @fatefi/api moltbook",
    "moltbook:register": "pnpm --filter @fatefi/api moltbook register",
    "moltbook:status": "pnpm --filter @fatefi/api moltbook status",
    "moltbook:post": "pnpm --filter @fatefi/api moltbook post-daily",
    "tunnel": "ngrok http 3001 --host-header=rewrite",
    "build": "pnpm run --parallel build:api build:web",
    "build:api": "pnpm --filter @fatefi/api build",
    "build:web": "pnpm --filter @fatefi/web build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}